# Clip the offscreen client-surface blit against overlapping siblings.
#
# Rhino keeps all four viewport windows mapped and simply raises the maximized
# one over the others. Each viewport owns an offscreen OpenGL surface that Wine
# blits back into the parent, and DCX_USESTYLE only clips against siblings when
# the window carries WS_CLIPSIBLINGS - which these do not. The covered surfaces
# therefore blit over the maximized viewport, which is what the black rectangles
# are. Asking for DCX_CLIPSIBLINGS explicitly restricts every present to the
# part of the window that is actually visible.

--- a/dlls/win32u/window.c	2026-10-06 14:32:53.664836300 +0200
+++ b/dlls/win32u/window.c	2026-10-06 14:32:58.896116800 +0200
@@ -436,7 +436,7 @@
     if ((hwnd = surface->hwnd))
     {
         client_surface_update_locked( surface );
-        if (surface->offscreen) hdc = NtUserGetDCEx( hwnd, 0, DCX_CACHE | DCX_USESTYLE );
+        if (surface->offscreen) hdc = NtUserGetDCEx( hwnd, 0, DCX_CACHE | DCX_USESTYLE | DCX_CLIPSIBLINGS );
         surface->funcs->present( surface, hdc );
         if (hdc) NtUserReleaseDC( hwnd, hdc );
     }
@@ -464,7 +464,7 @@
         if (!surface->offscreen) continue;
         client_surface_update_locked( surface );
         if (!surface->offscreen) continue;
-        if ((hdc = NtUserGetDCEx( surface->hwnd, 0, DCX_CACHE | DCX_USESTYLE )))
+        if ((hdc = NtUserGetDCEx( surface->hwnd, 0, DCX_CACHE | DCX_USESTYLE | DCX_CLIPSIBLINGS )))
         {
             surface->funcs->present( surface, hdc );
             NtUserReleaseDC( surface->hwnd, hdc );
