+
+/* Ask the owners of the OpenGL client surfaces under hwnd to repaint. An
+ * application that only draws on demand - a CAD viewport, for instance - does
+ * not redraw a child window that a layout change resized, so the drawable keeps
+ * its old size and the uncovered area stays black until something else triggers
+ * a paint.
+ *
+ * Deliberately narrow: no RDW_ERASE, because erasing a region the owner then
+ * never paints leaves it blank, and no invalidation of the parent, because that
+ * blanked unrelated controls in testing. */
+static void invalidate_client_surface_windows( HWND hwnd )
+{
+    struct client_surface *surface;
+    HWND windows[32];  /* enough for a CAD viewport layout */
+    UINT i, count = 0;
+
+    pthread_mutex_lock( &surfaces_lock );
+    LIST_FOR_EACH_ENTRY( surface, &client_surfaces, struct client_surface, entry )
+    {
+        if (!surface->hwnd) continue;
+        if (surface->hwnd != hwnd && surface->toplevel != hwnd &&
+            !is_child( hwnd, surface->hwnd )) continue;
+        for (i = 0; i < count; i++) if (windows[i] == surface->hwnd) break;
+        if (i < count) continue;
+        if (count == 32) break;
+        client_surface_update_locked( surface );
+        windows[count++] = surface->hwnd;
+    }
+    pthread_mutex_unlock( &surfaces_lock );
+
+    /* redraw outside the lock, painting re-enters the window code */
+    for (i = 0; i < count; i++)
+        NtUserRedrawWindow( windows[i], NULL, NULL, RDW_INVALIDATE );
+}
+
